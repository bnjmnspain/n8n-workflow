# ---- Workflow 1: Gmail Multi-Label ----------------------------------------
GMAIL_LABELS=label1,label2,label3,Invoices,Receipts,Documents
GMAIL_SHEET_ID=REPLACE_WITH_YOUR_SPREADSHEET_ID
GMAIL_SHEET_NAME=Email Log
GMAIL_DRIVE_ROOT_FOLDER_ID=REPLACE_WITH_YOUR_DRIVE_FOLDER_ID
GMAIL_LOOKBACK_WINDOW=1d
WORKFLOW_TIMEZONE=Asia/Manila
DATE_FORMAT=YYYY-MM-DD

# Note: the Schedule Trigger's polling interval is a node parameter, not an
# env var (n8n's built-in Schedule Trigger doesn't accept expressions for
# interval). Edit "Schedule — Poll Gmail" -> minutesInterval directly.

# ---- Workflow 2: Telegram Receipts ------------------------------------------
RECEIPTS_SHEET_ID=REPLACE_WITH_YOUR_SPREADSHEET_ID
RECEIPTS_SHEET_NAME=Receipts
RECEIPTS_DRIVE_ROOT_FOLDER_ID=REPLACE_WITH_YOUR_DRIVE_FOLDER_ID
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
RECEIPT_FIELDS=merchant_name,amount,currency,date,receipt_number,tax,subtotal,payment_method,confidence

# Never commit a real, populated copy of this file.
