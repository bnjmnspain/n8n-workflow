      },
      "id": "5a01f4cb-0001-4000-8000-000000000005",
      "name": "Drive \u2014 Lookup Sender Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        2340,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const looked = $('Drive \u2014 Lookup Sender Folder').first().json;\nconst created = $('Drive \u2014 Create Sender Folder').first().json;\nconst carry = $('Code \u2014 Resolve Date Folder Id').first().json;\nconst folderId = (looked && looked.id) || (created && created.id) || '';\nif (!folderId) throw new Error('Could not resolve Sender folder id');\nreturn [{ json: { ...carry, senderFolderId: folderId } }];"
      },
      "id": "5a01f4cb-0001-4000-8000-000000000006",
      "name": "Code \u2014 Resolve Sender Folder Id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        2600,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "attachmentsMeta",
        "options": {
          "destinationFieldName": "attachment"
        }
      },
      "id": "7530bdab-e4eb-4282-a18b-3cf879ee3fdb",
      "name": "Split \u2014 Each Attachment",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        2860,
        0
      ],
      "notes": "Splits the attachments array into one item per file. Other fields (senderFolderId, messageId) are carried through."
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "getAttachment",
        "messageId": "={{$json.messageId}}",
        "attachmentId": "={{$json.attachment.attachmentId}}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "60b5c074-92b8-49b2-85a9-e2d5c1002da3",
      "name": "Gmail \u2014 Download Attachment",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        3120,
        0
      ],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "notes": "Preserves the raw attachment bytes as binary data 'data'.",
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "name": "={{$json.attachment.filename}}",
        "options": {
          "parents": [
            "={{$json.senderFolderId}}"
          ]
        },
        "binaryPropertyName": "data"
      },
      "id": "396454fc-98c2-4dab-bc8a-ecd73324dfa8",
      "name": "Drive \u2014 Upload Attachment",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        3380,
        0
      ],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "notes": "Filename comes straight from the original Gmail attachment metadata \u2014 never renamed.",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "uploads"
      },
      "id": "de83f429-8e94-4afe-af3a-c9f412520a73",
      "name": "Aggregate \u2014 Collect Uploaded Files",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        3640,
        0
      ],
      "notes": "Combines however many attachments this one email had back into a single item, so the main workflow gets exactly one result per email."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collect every upload result, then carry the original email data\n// back to the parent workflow so it can be logged in Sheets.\nconst input = $input.first().json;\nconst uploads = input.uploads || [];\nconst driveFileIds = uploads.map(u => u.json && u.json.id).filter(Boolean);\nconst driveFileLinks = uploads.map(u => u.json && u.json.webViewLink).filter(Boolean);\nconst anyFailed = uploads.some(u => u.json && u.json.error);\n\nconst emailMeta = (uploads[0] && uploads[0].json) || input;\n\nreturn [{\n  json: {\n    ...emailMeta,\n    driveFileIds,\n    driveFileLinks,\n    uploadedCount: driveFileIds.length,\n    uploadStatus: anyFailed ? 'error' : 'ok',\n  }\n}];"
      },
      "id": "77592630-f7a8-44db-a973-8b3f1035ec0a",
      "name": "Code \u2014 Build Final Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        3900,
        0
      ]
    }
  ],
