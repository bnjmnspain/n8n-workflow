{
  "name": "Sub \u2014 Upload Gmail Attachments",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "bca58d4f-5f0c-4963-9ee2-631109fa12e3",
      "name": "Trigger \u2014 Receive Email Data",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "notes": "Receives the normalized email item from the main workflow: messageId, label, senderName, receivedDateFolder, driveRootFolderId, attachmentsMeta[]."
    },
    {
      "parameters": {
        "jsCode": "// Folder names must not contain characters Drive/other tools choke on.\nfunction sanitize(name) {\n  return String(name || 'Unknown')\n    .replace(/[\\\\/:*?\"<>|]/g, '-')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, 100) || 'Unknown';\n}\nconst j = $json;\nreturn [{\n  json: {\n    ...j,\n    labelFolderName: sanitize(j.label),\n    dateFolderName: sanitize(j.receivedDateFolder),\n    senderFolderName: sanitize(j.senderName),\n  }\n}];"
      },
      "id": "e4f8c1ac-71d2-4f46-90a6-e1da7041d39e",
      "name": "Code \u2014 Sanitize Folder Names",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "resource": "folder",
        "operation": "create",
        "name": "={{$json.labelFolderName}}",
        "options": {
          "parents": [
            "={{$json.driveRootFolderId}}"
          ]
        }
      },
      "id": "2133fe57-1946-4910-8041-6212add386f9",
      "name": "Drive \u2014 Create Label Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        520,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive OAuth2"
        }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "notes": "Native Google Drive node with OAuth2 credential. Continue-on-fail is on so a 'folder already exists' error doesn't halt the run \u2014 we then look it up in the next node."
    },
    {
      "parameters": {
        "resource": "folder",
        "operation": "list",
        "filter": {
          "name": "={{$json.labelFolderName}}",
          "parents": [
            "={{$json.driveRootFolderId}}"
          ]
        },
        "options": {}
      },
      "id": "5a01f4cb-0001-4000-8000-000000000001",
      "name": "Drive \u2014 Lookup Label Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        780,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive OAuth2"
        }
      },
      "notes": "Search by exact name + parent. Returns the existing folder, OR a fresh empty list if the create just succeeded (Drive search index is eventually-consistent \u2014 in that case the Code node falls back to the create node's output)."
    },
    {
      "parameters": {
        "jsCode": "// Prefer the lookup result. If the lookup is empty, fall back to the create node's output\n// (Drive search index is eventually consistent \u2014 a just-created folder may not appear yet).\nconst looked = $('Drive \u2014 Lookup Label Folder').first().json;\nconst created = $('Drive \u2014 Create Label Folder').first().json;\nconst carry = $('Code \u2014 Sanitize Folder Names').first().json;\n\nconst folderId = (looked && looked.id) || (created && created.id) || '';\nif (!folderId) {\n  throw new Error('Could not resolve Label folder id');\n}\nreturn [{ json: { ...carry, labelFolderId: folderId } }];"
      },
      "id": "5a01f4cb-0001-4000-8000-000000000002",
      "name": "Code \u2014 Resolve Label Folder Id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "resource": "folder",
        "operation": "create",
        "name": "={{$json.dateFolderName}}",
        "options": {
          "parents": [
            "={{$json.labelFolderId}}"
          ]
        }
      },
      "id": "c05d437e-ff41-4f6f-96a6-b1c707441b14",
      "name": "Drive \u2014 Create Date Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1300,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive OAuth2"
        }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resource": "folder",
        "operation": "list",
        "filter": {
          "name": "={{$json.dateFolderName}}",
          "parents": [
            "={{$json.labelFolderId}}"
          ]
        },
        "options": {}
      },
      "id": "5a01f4cb-0001-4000-8000-000000000003",
      "name": "Drive \u2014 Lookup Date Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1560,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const looked = $('Drive \u2014 Lookup Date Folder').first().json;\nconst created = $('Drive \u2014 Create Date Folder').first().json;\nconst carry = $('Code \u2014 Resolve Label Folder Id').first().json;\nconst folderId = (looked && looked.id) || (created && created.id) || '';\nif (!folderId) throw new Error('Could not resolve Date folder id');\nreturn [{ json: { ...carry, dateFolderId: folderId } }];"
      },
      "id": "5a01f4cb-0001-4000-8000-000000000004",
      "name": "Code \u2014 Resolve Date Folder Id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1820,
        0
      ]
    },
